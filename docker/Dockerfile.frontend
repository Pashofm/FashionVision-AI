# ============================================================
# FashionVision AI — Dockerfile Frontend
# ============================================================
# Multi-stage build para servir el frontend React con Nginx.
#
# Etapa 1 (builder): Node 20 Alpine
#   - Instala dependencias npm (npm ci para builds reproducibles)
#   - Compila la SPA con Vite (npm run build)
#   - Output: /app/dist (archivos estáticos optimizados)
#
# Etapa 2 (runtime): Nginx Alpine
#   - Copia los archivos estáticos desde el builder
#   - Configura Nginx como servidor de archivos + proxy reverso
#   - Proxy /api/ → backend:8000 para evitar CORS
#   - Habilita gzip para compresión de respuestas
# ============================================================

# ---- Etapa 1: Builder ----
FROM node:20-alpine AS builder

WORKDIR /app

# Instalar dependencias (capa cacheada si package*.json no cambia)
COPY frontend/package*.json ./
RUN npm ci

# Copiar código fuente y compilar
COPY frontend/ ./

# Variable de build: API se sirve desde el mismo dominio vía proxy Nginx
ENV VITE_API_URL=/
RUN npm run build

# ---- Etapa 2: Runtime ----
FROM nginx:alpine

# Copiar archivos estáticos compilados
COPY --from=builder /app/dist /usr/share/nginx/html

# Configuración inline de Nginx:
# - Sirve la SPA con fallback a index.html (para React Router)
# - Proxy /api/ → backend:8000 (evita configuración CORS compleja)
# - Habilita compresión gzip para mejor rendimiento
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://backend:8000; \
        proxy_http_version 1.1; \
        proxy_set_header Upgrade $http_upgrade; \
        proxy_set_header Connection "upgrade"; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
        proxy_cache_bypass $http_upgrade; \
    } \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml; \
    gzip_min_length 1000; \
    error_page 500 502 503 504 /50x.html; \
    location = /50x.html { \
        root /usr/share/nginx/html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
