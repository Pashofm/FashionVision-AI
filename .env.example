# FashionVision-AI — Template de Variables de Entorno
# ============================================================
# Copiar a .env:  cp .env.example .env
# Editar .env con tus valores reales antes de levantar el sistema.
# NUNCA commitear .env ni .env.local al repositorio.
# ============================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Credenciales de PostgreSQL. docker-compose propaga estas variables
# al contenedor db y construye DATABASE_URL para el backend.
POSTGRES_DB=fashionvision_ai
POSTGRES_USER=fashionvision_ai_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# DATABASE URLS (construidas a partir de las variables de arriba en Docker,
# o usadas directamente en desarrollo local)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://fashionvision_ai_user:change_this_password_in_production@localhost:5432/fashionvision_ai
DATABASE_URL_SYNC=postgresql://fashionvision_ai_user:change_this_password_in_production@localhost:5432/fashionvision_ai

# =============================================================================
# SECURITY — JWT Tokens
# =============================================================================
# Generar SECRET_KEY segura con:  openssl rand -base64 32
SECRET_KEY=generate_with_openssl_rand_base64_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# CORS & ORIGINS — Dominios permitidos para el frontend
# =============================================================================
# En desarrollo Vite corre en :5173, en producción nginx sirve en :80
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# ENVIRONMENT: "development" o "production"
#   - development: hot reload, SQL echo, debug logging
#   - production:  gunicorn workers, sin SQL echo, restart always
ENVIRONMENT=development
MODEL_PATH=/app/backend/models/best.pt
MEDIA_DIR=/app/media
MAX_IMAGE_SIZE_MB=5

# =============================================================================
# =============================================================================
# FRONTEND — Puerto público de Nginx
# =============================================================================
FRONTEND_HOST_PORT=80

# =============================================================================
# PGADMIN — Administración web de PostgreSQL (perfil opcional "tools")
# =============================================================================
# Se levanta con: docker compose --profile tools up -d pgadmin
PGADMIN_HOST_PORT=5050
PGADMIN_EMAIL=admin@fashionvision.com
PGADMIN_PASSWORD=change_this_password

# =============================================================================
# YOLO + CLIP — Detección y Matching de Prendas
# =============================================================================
# Per-class confidence thresholds (JSON). Lower thresholds for small objects.
YOLO_CLASS_THRESHOLDS={"accessories":0.30,"bags":0.35,"clothing":0.50,"shoes":0.45}
# Test-time augmentation (horizontal flip + scaling) for YOLO inference
YOLO_TTA_ENABLED=true
# YOLO min confidence floor
YOLO_MIN_CONFIDENCE=0.25
# YOLO inference image size (smaller = faster)
YOLO_IMGSZ=416
# CLIP fusion weight: 0.0 = no fusion, 1.0 = max boost to low-confidence YOLO detections
CLIP_FUSION_WEIGHT=0.60
# CLIP matching thresholds (cosine similarity)
CLIP_MATCH_THRESHOLD=0.35
CLIP_WEAK_MATCH_THRESHOLD=0.25
# Minimum gap between top-1 and top-2 CLIP match to avoid ambiguity
CLIP_GAP_THRESHOLD=0.08
# CLIP zero-shot class verification (corrects YOLO misclassifications)
CLIP_CLASS_VERIFY_ENABLED=true
# Require catalog match: if true, only show detections that matched a product
REQUIRE_CATALOG_MATCH=true
# Bbox size constraints by class (JSON)
BBOX_MAX_AREA_RATIO={"accessories":0.30,"bags":0.40}
BBOX_MAX_Y_RATIO={"accessories":0.50,"shoes":0.60}

# =============================================================================
# CLOUDINARY — Almacenamiento de imágenes (opcional)
# =============================================================================
# Sin estas variables, las imágenes no se guardarán en Cloudinary pero
# la vectorización y detección funcionan igual.
# Obtén credenciales gratuitas en: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
