# FashionVision-AI - Docker Environment Template
# Copiar este archivo a .env y completar con valores reales

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=fashionvision_ai
POSTGRES_USER=fashionvision_ai_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_HOST_PORT=5432

# URL síncrona (usada por Alembic para migraciones)
DATABASE_URL_SYNC=postgresql://fashionvision_ai_user:your_strong_password_here@localhost:5432/fashionvision_ai

# =============================================================================
# SECURITY
# =============================================================================
SECRET_KEY=generate_with_openssl_rand_base64 32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# CORS & ORIGINS
# =============================================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=development
MODEL_PATH=backend/models/best.pt
MEDIA_DIR=backend/media
MAX_IMAGE_SIZE_MB=5

# =============================================================================
# PORTS
# =============================================================================
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=80
PGADMIN_HOST_PORT=5050

# =============================================================================
# PGADMIN
# =============================================================================
PGADMIN_EMAIL=admin@fashionvision.com
PGADMIN_PASSWORD=pgadmin_strong_password

# =============================================================================
# CLOUDINARY (Opcional - solo si usas upload a la nube)
# =============================================================================
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
