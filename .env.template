# FashionVision-AI - Environment Configuration Template
# Copy this file to .env and configure with your values
# DO NOT commit .env files with real credentials to version control

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=fashionvision_ai
POSTGRES_USER=fashionvision_ai_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST_PORT=5432

# Database URLs (async for FastAPI, sync for Alembic)
DATABASE_URL=postgresql+asyncpg://fashionvision_ai_user:your_password_here@localhost:5432/fashionvision_ai
DATABASE_URL_SYNC=postgresql://fashionvision_ai_user:your_password_here@localhost:5432/fashionvision_ai

# =============================================================================
# SECURITY
# =============================================================================
SECRET_KEY=changeme_dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# CORS & ORIGINS
# =============================================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=development
MODEL_PATH=backend/models/best.pt
MEDIA_DIR=backend/media
MAX_IMAGE_SIZE_MB=5

# =============================================================================
# PORTS
# =============================================================================
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
PGADMIN_HOST_PORT=5050

# =============================================================================
# PGADMIN
# =============================================================================
PGADMIN_EMAIL=admin@fashionvision.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# =============================================================================
# CLOUDINARY (Optional - only if using cloud image storage)
# =============================================================================
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret