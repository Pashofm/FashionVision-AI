# FashionVision-AI — Plantilla de Variables de Entorno
# Copiar a .env:  cp .env.template .env
# NUNCA commitear .env ni .env.local con credenciales reales

# =============================================================================
# REQUERIDO — Base de Datos
# =============================================================================
POSTGRES_DB=fashionvision_ai
POSTGRES_USER=fashionvision_ai_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_HOST=localhost
POSTGRES_HOST_PORT=5432

# URLs de conexión (async para FastAPI, sync para Alembic)
DATABASE_URL=postgresql+asyncpg://fashionvision_ai_user:your_db_password_here@localhost:5432/fashionvision_ai
DATABASE_URL_SYNC=postgresql://fashionvision_ai_user:your_db_password_here@localhost:5432/fashionvision_ai

# =============================================================================
# REQUERIDO — Seguridad (cambiar en producción)
# =============================================================================
SECRET_KEY=changeme_dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# REQUERIDO — CORS y Orígenes
# =============================================================================
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# =============================================================================
# REQUERIDO — Configuración de la Aplicación
# =============================================================================
ENVIRONMENT=development
MODEL_PATH=backend/models/best.pt
MAX_IMAGE_SIZE_MB=5

# =============================================================================
# OPCIONAL — Cloudinary (almacenamiento de imágenes en la nube)
# Sin estas variables, la vectorización de productos funciona igual,
# pero las imágenes no se almacenarán en la galería del producto.
# Obtén credenciales gratuitas en: https://console.cloudinary.com
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# OPCIONAL — Timezone y Headers
# =============================================================================
CLIENT_TIMEZONE_HEADER=X-Timezone
DEFAULT_TIMEZONE=America/Mazatlan

# =============================================================================
# OPCIONAL — Puertos y PGAdmin (solo para despliegue con Docker)
# =============================================================================
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
PGADMIN_HOST_PORT=5050
PGADMIN_EMAIL=admin@fashionvision.com
PGADMIN_PASSWORD=your_pgadmin_password_here
